# dependencies
node_modules/

# build output — `lib/` is COMMITTED: DSH installs plugins from git via pnpm,
# which blocks dependency build scripts (prepare) until allowed, so a git
# checkout must already contain the compiled bundle. `dist/` stays ignored.
dist/

# logs
*.log
npm-debug.log*

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# env / secrets — never commit API keys
.env
.env.*
!.env.example
*.local

# test artifacts
coverage/

# local pnpm lockfile (CI uses npm; a pnpm lock would drift from npm install)
pnpm-lock.yaml
